# Linux x86-64 (glibc 2.28+) cross build from Windows using zig's bundled clang and libc headers.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(ZIG_DIR "C:/Tools/zig-x86_64-windows-0.17.0" CACHE PATH "zig root")
set(CMAKE_C_COMPILER "${CMAKE_CURRENT_LIST_DIR}/zig-cc.cmd")
set(CMAKE_CXX_COMPILER "${CMAKE_CURRENT_LIST_DIR}/zig-cxx.cmd")
set(CMAKE_AR "${CMAKE_CURRENT_LIST_DIR}/zig-ar.cmd")
set(CMAKE_RANLIB "${CMAKE_CURRENT_LIST_DIR}/zig-ranlib.cmd")
set(CMAKE_C_COMPILER_TARGET x86_64-linux-gnu.2.28)
set(CMAKE_CXX_COMPILER_TARGET x86_64-linux-gnu.2.28)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# Headers, .pc files and shared objects of SDL's run-time dependencies (X11, PulseAudio, ALSA, libudev, D-Bus):
# python tools/linux_sysroot.py. Only headers and sonames are taken from it; zig's own glibc stays the libc.
set(F1CE_LINUX_SYSROOT "${CMAKE_CURRENT_LIST_DIR}/../third_party/linux-sysroot" CACHE PATH "tools/linux_sysroot.py output")
get_filename_component(F1CE_LINUX_SYSROOT "${F1CE_LINUX_SYSROOT}" ABSOLUTE)
if(EXISTS "${F1CE_LINUX_SYSROOT}/usr/include/X11/Xlib.h")
  set(CMAKE_FIND_ROOT_PATH "${F1CE_LINUX_SYSROOT}")
  set(CMAKE_LIBRARY_ARCHITECTURE x86_64-linux-gnu)
  # after zig's libc headers, so only the libraries' own headers come from it
  set(CMAKE_C_FLAGS_INIT "-idirafter ${F1CE_LINUX_SYSROOT}/usr/include")
  set(CMAKE_CXX_FLAGS_INIT "-idirafter ${F1CE_LINUX_SYSROOT}/usr/include")
  set(PKG_CONFIG_EXECUTABLE "${CMAKE_CURRENT_LIST_DIR}/pkg-config.cmd" CACHE FILEPATH "")
  set(ENV{F1CE_LINUX_SYSROOT} "${F1CE_LINUX_SYSROOT}")
  # SDL takes the soname it loads at run time from the file find_library returns, with symbolic links resolved; the
  # sysroot holds copies instead of links (Windows), so its <NAME>_LIB entries point at the versioned files
  # (libX11.so.6.3.0 -> "libX11.so.6", not the development name "libX11.so" that only -dev packages install)
  file(GLOB _f1ce_versioned "${F1CE_LINUX_SYSROOT}/usr/lib/x86_64-linux-gnu/lib*.so.*.*"
                            "${F1CE_LINUX_SYSROOT}/lib/x86_64-linux-gnu/lib*.so.*.*")
  foreach(_f ${_f1ce_versioned})
    get_filename_component(_n "${_f}" NAME)
    string(REGEX REPLACE "^lib(.*)\\.so\\..*$" "\\1" _n "${_n}")
    string(TOUPPER "${_n}" _n)
    string(REPLACE "-" "_" _n "${_n}")
    set(${_n}_LIB "${_f}" CACHE FILEPATH "")
  endforeach()
else()
  message(WARNING "No Linux sysroot (python tools/linux_sysroot.py): SDL gets no X11/audio backends")
endif()
set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)   # (zig's driver cannot emit clang PCH files; SDL uses them)
set(THREADS_PREFER_PTHREAD_FLAG ON)
set(CMAKE_THREAD_LIBS_INIT "-lpthread")
set(CMAKE_HAVE_THREADS_LIBRARY 1)
set(Threads_FOUND TRUE)
